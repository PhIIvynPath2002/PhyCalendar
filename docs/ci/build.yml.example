name: Build and release
on:
  push:
    branches: [main]
    tags: ['v2.*']
  workflow_dispatch:
permissions:
  contents: read
jobs:
  web:
    if: github.event.repository.private == false
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: npm
      - run: npm ci
      - run: npm test
      - run: npm run build
      - run: npx playwright install --with-deps chromium
      - run: npm run test:browser
      - run: npm run package:source
      - uses: actions/upload-artifact@v4
        with:
          name: web-and-source
          path: |
            release/PhyCalendar-*-source.zip
            release/PhyCalendar-*-PWA.zip
  apple:
    needs: web
    # Public repositories use standard hosted runners for free; do not bill a private repo by default.
    if: github.event.repository.private == false
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: npm
      - run: npm ci
      - run: xcodebuild -version
      - name: Build Mac installers (no Developer ID / no notarization)
        run: npm run dist:mac
        env:
          CSC_IDENTITY_AUTO_DISCOVERY: 'false'
      - name: Build iOS simulator and unsigned device app
        run: sh scripts/build-ios.sh
      - name: Package iOS outputs with explicit limitations
        run: |
          ditto -c -k --sequesterRsrc --keepParent release/ios-simulator/Build/Products/Debug-iphonesimulator/App.app release/PhyCalendar-2.0.0-iOS-SIMULATOR-ONLY.zip
          ditto -c -k --sequesterRsrc --keepParent release/ios-device/Build/Products/Release-iphoneos/App.app release/PhyCalendar-2.0.0-iOS-UNSIGNED-NOT-INSTALLABLE.zip
          cp docs/INSTALL-zh.md release/安装说明.md
      - uses: actions/upload-artifact@v4
        with:
          name: apple-builds
          path: |
            release/*.zip
            release/*.dmg
            release/安装说明.md
  release:
    needs: [web, apple]
    if: startsWith(github.ref, 'refs/tags/v2.')
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/download-artifact@v4
        with:
          merge-multiple: true
          path: release
      - name: Publish only successfully built files
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          cd release
          sha256sum *.zip *.dmg > SHA256SUMS.txt
          gh release create "$GITHUB_REF_NAME" *.zip *.dmg 安装说明.md SHA256SUMS.txt --repo "$GITHUB_REPOSITORY" --verify-tag --title "个人订阅日历 $GITHUB_REF_NAME · 本地免登录版" --notes-file ../docs/RELEASE-v2.0.0.md
